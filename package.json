{
  "name": "nexus-privacy-agent",
  "description": "Nexus Privacy Agent - Privacy-first browser automation agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && node -e \"import('fs').then(fs => fs.cpSync('.output/chrome-mv3', 'extension-dist', {recursive: true}))\"",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test:live": "node test-live.mjs",
    "server:start": "uvicorn server.main:app --host 127.0.0.1 --port 8000 --reload",
    "server:test": "python -m server.test_agent",
    "demo": "node run-demo.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "onnxruntime-web": "^1.29.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
